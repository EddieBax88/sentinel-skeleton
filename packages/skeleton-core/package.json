{
  "name": "@sentinel/skeleton-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./test-utils": {
      "types": "./dist-test-utils/runInvariants.d.ts",
      "default": "./dist-test-utils/runInvariants.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "build:test-utils": "tsc -b tsconfig.test-utils.json",
    "check:boundary": "tsc -b tsconfig.json && node scripts/check-no-fast-check.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest --run",
    "verify": "npm run typecheck && npm run test && npm run build && npm run build:test-utils && npm run check:boundary"
  },
  "devDependencies": {
    "fast-check": "4.10.2",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
